{
  "$schema": "https://v2-10-9.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".nuxt/**", ".output/**", "migrations/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    }
  }
}
